# Bu faylni .env nomi bilan nusxalang. .env ga faqat bot ishlaydigan foydalanuvchi kira olsin.
# Ishlab chiqishda TEST bot tokeni, test kanal va test guruhdan foydalaning.

BOT_TOKEN=123456:replace_with_botfather_token
REPORT_CHANNEL_ID=-1001234567890
# Tashkilotning asosiy guruhi (live lokatsiyalar shu yerga tushadi). 4-bosqichdan boshlab kerak.
MAIN_GROUP_ID=

# Asosiy admin (bitta). Botni ishga tushirganda unga admin roli beriladi.
MAIN_ADMIN_ID=123456789
# Zaxira akkauntlar va maxfiy so'z xeshi (8-bosqich). Bot orqali o'zgartirilmaydi.
BACKUP_ADMIN_IDS=
EMERGENCY_PHRASE_HASH=

# Runtime fayllar papkasi (baza, loglar, backup, arxiv). Bo'sh bo'lsa: <loyiha>\var
DATA_DIR=
# Excel fayllar qo'yiladigan papka. Bo'sh bo'lsa: <DATA_DIR>\import
IMPORT_DIR=
